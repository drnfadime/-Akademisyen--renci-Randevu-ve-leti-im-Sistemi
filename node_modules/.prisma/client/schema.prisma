datasource db {
  provider = "postgresql" // postgre sqle geçtim render sitesinde mysql desteği yoktu
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

model User {
  id           Int           @id
  email        String        @unique
  name         String
  surname      String
  password     String
  appointments Appointment[]
}

model Teacher {
  Teacherid    Int           @id
  email        String        @unique
  name         String
  surname      String
  password     String
  appointments Appointment[]
  timeTable    timeTable[]
}

model timeTable {
  timeTableid Int     @id
  teacherId   Int
  day         String
  startTime   String
  endTime     String
  teacher     Teacher @relation(fields: [teacherId], references: [Teacherid])
}

model Appointment {
  Appointmentid Int      @id
  date          DateTime
  studentId     Int
  teacherId     Int
  isonline      Boolean
  old           Boolean
  subject       String
  student       User     @relation(fields: [studentId], references: [id])
  teacher       Teacher  @relation(fields: [teacherId], references: [Teacherid])
}
